<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <!-- Wear OS 5+/Android 16 gates Health Services heart rate behind the Health Connect permission
         as well as BODY_SENSORS; without it ExerciseClient logs a SecurityException per sample and
         the phone never sees a bpm. Requested at runtime alongside BODY_SENSORS in MainActivity. -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Forge"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Requires the phone app to be installed/paired — this is a companion, not a standalone
             watch app, per the confirmed v1 scope (mirror + heart rate). -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <!-- Receives the phone's session snapshots whether or not the app is running, and launches
             MainActivity on an active one. The path filter keeps Play Services from waking us for
             messages that aren't ours. -->
        <service
            android:name=".data.ForgeListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/forge/session" />
            </intent-filter>
        </service>

        <!-- A watch face doesn't rotate and neither should this. "locked" freezes whatever rotation the
             display has when the activity opens (this Galaxy Watch runs at ROTATION_270 with system
             auto-rotate on) instead of "nosensor", which would snap to the natural orientation and
             could render upside-down relative to the watch face. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="locked"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
